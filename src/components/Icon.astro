---
/**
 * Icon — reusable inline-SVG icon set (zero dependencies, no runtime JS).
 *
 * Decorative by default (aria-hidden="true"). Pass `label` to expose an
 * accessible name when the icon carries meaning on its own
 * (see AGENTS.md -> WCAG 2.1 AA).
 */
export interface Props {
  /** Icon key. Unknown keys fall back to `window`. */
  name: string;
  /** Rendered width/height in px. */
  size?: number;
  /** Stroke width for outline icons. */
  strokeWidth?: number;
  /** Extra classes forwarded to the <svg>. */
  class?: string;
  /** Accessible name. When set, the icon becomes meaningful (role="img"). */
  label?: string;
}

const { name, size = 24, strokeWidth = 2, class: className, label } = Astro.props;

// Inner SVG markup for each icon (24x24 viewBox, drawn with currentColor).
const paths: Record<string, string> = {
  window: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 3v18M3 12h18"/>',
  balcony:
    '<path d="M4 21V10h16v11"/><path d="M4 14h16"/><path d="M4 18h16"/><path d="M9 10V6h6v4"/>',
  house:
    '<path d="M3 10.5L12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/>',
  quiet:
    '<path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M22 9l-6 6"/><path d="M16 9l6 6"/>',
  factory: '<path d="M2 20h20"/><path d="M4 20V9l5 3V9l5 3V4l6 3v13"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9.5 12l1.8 1.8L15 10"/>',
  award: '<circle cx="12" cy="9" r="5"/><path d="M8.5 13.5L7 22l5-3 5 3-1.5-8.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  tag: '<path d="M20.6 13.4l-7.2 7.2a2 2 0 01-2.8 0L3 13V3h10l7.6 7.6a2 2 0 010 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
  users:
    '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0112 0"/><path d="M16 6a3 3 0 010 6"/><path d="M17 20a6 6 0 00-3-5"/>',
  truck:
    '<path d="M3 6h11v11H3z"/><path d="M14 9h4l3 3v5h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>',
  tools:
    '<path d="M4 6h16M4 12h16M4 18h16"/><circle cx="9" cy="6" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="9" cy="18" r="2"/>',
  thermometer: '<path d="M10 13V5a2 2 0 114 0v8a3 3 0 11-4 0z"/>',
  phone:
    '<path d="M4 4h4l2 5-2.5 1.5a12 12 0 006 6L15 14l5 2v4a1 1 0 01-1 1A16 16 0 013 5a1 1 0 011-1z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  'map-pin':
    '<path d="M12 21s-7-5.5-7-11a7 7 0 0114 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  check: '<path d="M20 6L9 17l-5-5"/>',
  'arrow-right': '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
  star: '<path d="M12 2.5l2.9 5.9 6.6 1-4.8 4.6 1.1 6.5L12 17.9 6.2 20.5l1.1-6.5L2.5 9.4l6.6-1z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
};

const inner = paths[name] ?? paths.window;
const isFilled = name === 'star';
const decorative = !label;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={isFilled ? undefined : strokeWidth}
  stroke-linecap={isFilled ? undefined : 'round'}
  stroke-linejoin={isFilled ? undefined : 'round'}
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
  {label && <title>{label}</title>}
  <Fragment set:html={inner} />
</svg>
