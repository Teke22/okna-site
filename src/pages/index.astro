---
import Layout from '../layouts/Layout.astro';

// SEO: title 30–60 символов, description 120–160 символов
const title = 'Пластиковые окна под ключ | Окна-Сервис';
const description =
  'Производство и установка пластиковых окон в квартирах и частных домах. Замер, доставка, монтаж и гарантия. Рассчитайте стоимость онлайн.';

// Нормализуем BASE_URL, чтобы не было склейки вида /okna-siteabout/
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const withBase = (path: string) => base + (path.startsWith('/') ? path.slice(1) : path);

// Канонический URL страницы для структурированных данных (Astro доступен в frontmatter)
const canonicalUrl =
  Astro.site != null
    ? new URL(Astro.url.pathname, Astro.site).href
    : Astro.url.pathname;
---

<Layout title={title} description={description} lang="ru">
	<a class="skip-link" href="#main-content">Перейти к основному содержимому</a>

	<header class="site-header">
		<div class="site-header__inner">
			<a class="brand" href={base}>Окна-Сервис</a>
			<nav aria-label="Основная навигация">
				<ul class="nav">
					<li><a href={base}>Главная</a></li>
					<li><a href={withBase('about/')}>О нас</a></li>
					<li><a href="#contact">Контакты</a></li>
				</ul>
			</nav>
		</div>
	</header>

	<main id="main-content">
		<section class="hero">
			<h1>Пластиковые окна под ключ</h1>
			<p>
				Производим и устанавливаем окна ПВХ для квартир и частных домов. Бесплатный замер,
				аккуратный монтаж и гарантия до 5 лет.
			</p>
			<p>
				<a class="button" href="#contact">Рассчитать стоимость</a>
			</p>
		</section>

		<section class="section" aria-labelledby="services-title">
			<h2 id="services-title">Что мы делаем</h2>
			<ul class="cards">
				<li class="card">
					<h3>Окна в квартиру</h3>
					<p>Замер, изготовление и монтаж с сохранением отделки. Убираем мусор после работы.</p>
				</li>
				<li class="card">
					<h3>Остекление домов</h3>
					<p>Энергоэффективные профили и стеклопакеты для тёплого и тихого дома круглый год.</p>
				</li>
				<li class="card">
					<h3>Ремонт и сервис</h3>
					<p>Регулировка, замена фурнитуры и уплотнителей. Выезд мастера в течение 1–2 дней.</p>
				</li>
			</ul>
		</section>

		<section class="section" aria-labelledby="advantages-title">
			<h2 id="advantages-title">Почему выбирают нас</h2>
			<ul class="features">
				<li>Собственное производство — без посредников и наценок.</li>
				<li>Фиксированная смета: цена в договоре не меняется.</li>
				<li>Гарантия на изделия и монтаж до 5 лет.</li>
				<li>Более 2 000 установленных окон за 10 лет работы.</li>
			</ul>
		</section>

		<section class="section section--contact" id="contact" aria-labelledby="contact-title">
			<h2 id="contact-title">Оставьте заявку на замер</h2>
			<p>
				Позвоните по телефону <a href="tel:+78001234567">+7 (800) 123-45-67</a> или напишите на
				<a href="mailto:zakaz@okna-service.example">zakaz@okna-service.example</a>. Ответим на
				вопросы и подберём решение под ваш бюджет.
			</p>
		</section>
	</main>

	<footer class="site-footer">
		<p>© 2024 Окна-Сервис. Пластиковые окна под ключ в вашем городе.</p>
	</footer>

		<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'LocalBusiness',
			name: 'Окна-Сервис',
			description,
			url: canonicalUrl,
			telephone: '+78001234567',
		})}
	/>
</Layout>

<style>
	:root {
		--color-bg: #ffffff;
		--color-surface: #f8fafc;
		--color-text: #111827;
		--color-muted: #374151;
		--color-brand: #3245ff;
		--color-brand-strong: #2334d6;
		--color-on-brand: #ffffff;
		--color-border: #e5e7eb;
		--radius: 0.75rem;
		--space-1: 0.5rem;
		--space-2: 1rem;
		--space-3: 1.5rem;
		--space-4: 2.5rem;
		--maxw: 68rem;
		--font: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
	}

	:global(body) {
		font-family: var(--font);
		color: var(--color-text);
		background: var(--color-bg);
	}

	a:focus-visible,
	button:focus-visible {
		outline: 3px solid var(--color-brand);
		outline-offset: 2px;
		border-radius: 0.25rem;
	}

	.skip-link {
		position: absolute;
		left: 1rem;
		top: -3rem;
		z-index: 10;
		background: var(--color-brand);
		color: var(--color-on-brand);
		padding: 0.5rem 1rem;
		border-radius: 0.75rem;
		text-decoration: none;
	}

	.skip-link:focus {
		top: 1rem;
	}

	.site-header {
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__inner {
		max-width: 68rem;
		margin: 0 auto;
		padding: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
	}

	.brand {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-text);
		text-decoration: none;
	}

	.nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav a {
		color: var(--color-muted);
		text-decoration: none;
	}

	.nav a:hover {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	main {
		max-width: 68rem;
		margin: 0 auto;
		padding: 2.5rem 1rem;
	}

	.hero {
		padding: 2rem 0;
	}

	.hero h1 {
		font-size: 2rem;
		line-height: 1.2;
		margin: 0 0 0.5em;
	}

	.hero p {
		font-size: 1.0625rem;
		color: var(--color-muted);
		max-width: 44rem;
		margin: 0 0 1.5em;
	}

	.button {
		display: inline-block;
		background: var(--color-brand);
		color: var(--color-on-brand);
		text-decoration: none;
		padding: 0.75rem 1.25rem;
		border-radius: 0.75rem;
		font-weight: 600;
	}

	.button:hover {
		background: var(--color-brand-strong);
	}

	.section {
		margin-top: 2.5rem;
	}

	.section h2 {
		font-size: 1.5rem;
		margin: 0 0 1rem;
	}

	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: 1fr;
	}

	.card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		padding: 1.5rem;
	}

	.card h3 {
		margin: 0 0 0.5em;
		font-size: 1.125rem;
	}

	.card p {
		margin: 0;
		color: var(--color-muted);
	}

	.features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}

	.features li {
		position: relative;
		padding-left: 1.75rem;
		color: var(--color-muted);
	}

	.features li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--color-brand);
	}

	.section--contact {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		padding: 1.5rem;
	}

	.section--contact a {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.section--contact a:hover {
		color: var(--color-brand-strong);
	}

	.site-footer {
		border-top: 1px solid var(--color-border);
	}

	.site-footer p {
		max-width: 68rem;
		margin: 0 auto;
		padding: 1.5rem 1rem;
		color: var(--color-muted);
		font-size: 0.9375rem;
	}

	@media (min-width: 30rem) {
		.cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 48rem) {
		.hero {
			padding: 3rem 0;
		}

		.hero h1 {
			font-size: 2.75rem;
		}

		.cards {
			grid-template-columns: repeat(3, 1fr);
		}

		.features {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.skip-link {
			transition: top 0.2s ease;
		}

		.button {
			transition: background-color 0.2s ease;
		}
	}
</style>
