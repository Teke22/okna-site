---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';

// SEO: title 30–60 символов, description 120–160 символов
const title = 'Пластиковые окна под ключ | DENDY IMPERIAL WIN HUB';
const description =
  'Производим и устанавливаем пластиковые окна в квартирах, частных домах и на балконах. Бесплатный замер, монтаж под ключ и гарантия 5 лет.';

// Нормализуем BASE_URL, чтобы не было склейки вида /okna-siteabout/
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const canonicalUrl =
  Astro.site != null ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const services = [
  {
    icon: 'window',
    title: 'Окна в квартиру',
    description:
      'Замер, изготовление и монтаж с сохранением отделки. Аккуратно убираем мусор после работы.',
  },
  {
    icon: 'balcony',
    title: 'Остекление балконов',
    description:
      'Тёплое и холодное остекление лоджий: защита от шума, пыли и сквозняков круглый год.',
  },
  {
    icon: 'house',
    title: 'Окна в частный дом',
    description:
      'Энергоэффективные профили и стеклопакеты для тёплого дома. Подберём решение под архитектуру.',
  },
  {
    icon: 'quiet',
    title: 'Тихие окна',
    description:
      'Шумозащитные стеклопакеты снижают уличный шум до 40 дБ — тишина даже рядом с дорогой.',
  },
];

const advantages = [
  {
    icon: 'factory',
    title: 'Собственное производство',
    text: 'Контролируем качество на каждом этапе и держим честные цены без посредников.',
  },
  {
    icon: 'shield',
    title: 'Гарантия 5 лет',
    text: 'Отвечаем за профиль, стеклопакет, фурнитуру и монтаж по договору.',
  },
  {
    icon: 'clock',
    title: 'Срок изготовления от 5 дней',
    text: 'Замер и монтаж в удобное время, включая выходные.',
  },
  {
    icon: 'tag',
    title: 'Фиксированная смета',
    text: 'Цена в договоре не меняется: никаких доплат после подписания.',
  },
  {
    icon: 'users',
    title: 'Свои монтажные бригады',
    text: 'Работы выполняют штатные мастера со стажем от 8 лет.',
  },
  {
    icon: 'thermometer',
    title: 'Тепло и тишина',
    text: 'Энергоэффективные стеклопакеты сохраняют тепло зимой и прохладу летом.',
  },
];

const reviews = [
  {
    name: 'Анна В.',
    location: 'Кишинёв',
    text: 'Заменили окна в двух комнатах за один день. Приехали вовремя, работали аккуратно, после монтажа всё убрали. Стало заметно тише и теплее.',
  },
  {
    name: 'Дмитрий К.',
    location: 'Кишинёв',
    text: 'Заказывали остекление балкона. Помогли выбрать профиль под бюджет, сделали ровно в срок. Цена совпала со сметой, доплат не было.',
  },
  {
    name: 'Елена С.',
    location: 'Оргеев',
    text: 'Ставили окна в частный дом. Понравился подход: сначала замер и расчёт, потом договор. Гарантию оформили письменно, мастера вежливые.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'DENDY IMPERIAL WIN HUB',
  description,
  url: canonicalUrl,
  telephone: '+78001234567',
  email: 'zakaz@okna-service.example',
  priceRange: '$$',
  image: new URL(`${base}favicon.svg`, Astro.site ?? Astro.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Примерная, д. 1',
    addressLocality: 'Кишинёв',
    addressCountry: 'MD',
  },
  openingHours: 'Mo-Sa 09:00-20:00',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '128',
  },
};
---

<Layout title={title} description={description} lang="ru" activePage="home">
	<Hero
		base={base}
		eyebrow="Окна ПВХ от производителя с 2010 года"
		title="Пластиковые окна под ключ с гарантией 5 лет"
		subtitle="Производим и устанавливаем окна для квартир и частных домов. Бесплатный замер, аккуратный монтаж и честная фиксированная цена."
		primaryLabel="Заказать замер"
		primaryHref={`${base}contacts/#form`}
		calculatorHref={`${base}kalkulyator/`}
		secondaryLabel="Смотреть услуги"
		secondaryHref={`${base}uslugi/`}
		badges={['Бесплатный замер', 'Монтаж под ключ', 'Гарантия 5 лет', 'Более 5000 окон']}
	/>

	<main id="main-content">
		<section class="section wrap" aria-labelledby="services-title">
			<div class="section__head">
				<h2 id="services-title">Что мы делаем</h2>
				<p class="section__lead">
					Полный цикл — от замера и производства до монтажа и сервисного обслуживания.
				</p>
			</div>

			<div class="grid grid--services">
				{
					services.map((service) => (
						<ServiceCard
							icon={service.icon}
							title={service.title}
							description={service.description}
							href={`${base}uslugi/`}
							linkLabel="Подробнее об услуге"
						/>
					))
				}
			</div>
		</section>

		<section class="section wrap" aria-labelledby="advantages-title">
			<div class="section__head">
				<h2 id="advantages-title">Почему выбирают нас</h2>
				<p class="section__lead">
					Работаем по договору, отвечаем за результат и не скрываем цену.
				</p>
			</div>

			<ul class="features">
				{
					advantages.map((item) => (
						<li class="feature">
							<span class="feature__icon">
								<Icon name={item.icon} size={22} />
							</span>
							<div>
								<h3 class="feature__title">{item.title}</h3>
								<p class="feature__text">{item.text}</p>
							</div>
						</li>
					))
				}
			</ul>
		</section>

		<section class="section wrap" aria-labelledby="reviews-title">
			<div class="section__head">
				<h2 id="reviews-title">Отзывы клиентов</h2>
				<p class="section__lead">Реальные истории клиентов, которые уже заменили окна вместе с нами.</p>
			</div>

			<div class="grid grid--reviews">
				{
					reviews.map((review) => (
						<figure class="review">
							<div class="review__stars" role="img" aria-label="Оценка 5 из 5">
								{[0, 1, 2, 3, 4].map(() => (
									<Icon name="star" size={18} />
								))}
							</div>
							<blockquote class="review__text">{review.text}</blockquote>
							<figcaption class="review__author">
								<strong>{review.name}</strong>
								<span>{review.location}</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</section>

		<CtaSection base={base} />
	</main>

	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style>
	.wrap {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 var(--space-2);
	}

	.section {
		margin-top: var(--space-5);
	}

	.section__head {
		max-width: 44rem;
		margin-bottom: var(--space-3);
	}

	.section__head h2 {
		margin: 0 0 var(--space-1);
		font-size: var(--font-size-h2);
		line-height: var(--line-height-heading);
	}

	.section__lead {
		margin: 0;
		color: var(--color-muted);
		font-size: var(--font-size-lead);
	}

	.grid {
		display: grid;
		gap: var(--space-2);
		grid-template-columns: 1fr;
	}

	.features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
		grid-template-columns: 1fr;
	}

	.feature {
		display: flex;
		gap: var(--space-2);
		align-items: flex-start;
		padding: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
	}

	.feature__icon {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius);
		background: color-mix(in srgb, var(--color-accent) 14%, transparent);
		color: var(--color-accent);
	}

	.feature__title {
		margin: 0 0 0.25em;
		font-size: var(--font-size-h3);
	}

	.feature__text {
		margin: 0;
		color: var(--color-muted);
	}

	.review {
		margin: 0;
		display: grid;
		gap: var(--space-2);
		align-content: start;
		padding: var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		height: 100%;
	}

	.review__stars {
		display: inline-flex;
		gap: 2px;
		color: var(--color-accent);
	}

	.review__text {
		margin: 0;
		color: var(--color-text);
	}

	.review__author {
		display: flex;
		flex-direction: column;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.review__author strong {
		color: var(--color-text);
	}

	@media (min-width: 34rem) {
		.grid--services,
		.grid--reviews,
		.features {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 52rem) {
		.grid--services {
			grid-template-columns: repeat(4, 1fr);
		}

		.features {
			grid-template-columns: repeat(3, 1fr);
		}

		.grid--reviews {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
