---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';

// SEO: title 30–60 символов, description 120–160 символов
const title = 'Услуги: окна, балконы и дома | DENDY IMPERIAL WIND HUB';
const description =
  'Установка пластиковых окон в квартиру, остекление балконов, окна для частного дома и шумозащитные «тихие» окна. Бесплатный замер и монтаж под ключ.';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const canonicalUrl =
  Astro.site != null ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const services = [
  {
    id: 'flat',
    icon: 'window',
    title: 'Окна в квартиру',
    price: 'от 5 300 lei',
    text: 'Замер, изготовление и монтаж окон с сохранением отделки. Аккуратно убираем мусор после установки.',
    features: [
      'Профиль ПВХ 5–6 камер с двойным контуром уплотнения',
      'Двухкамерный энергосберегающий стеклопакет',
      'Подоконники, откосы и москитные сетки',
      'Монтаж по ГОСТ с пароизоляцией шва',
    ],
  },
  {
    id: 'balcony',
    icon: 'balcony',
    title: 'Остекление балконов и лоджий',
    price: 'от 8 400 lei',
    text: 'Тёплое и холодное остекление с учётом типа парапета. Поможем превратить балкон в дополнительную комнату.',
    features: [
      'Тёплый и холодный варианты остекления',
      'Вынос и усиление парапета',
      'Отделка и утепление по желанию',
      'Защита от шума, пыли и сквозняков',
    ],
  },
  {
    id: 'house',
    icon: 'house',
    title: 'Окна в частный дом',
    price: 'от 6 600 lei',
    text: 'Энергоэффективные окна для домов и коттеджей. Подбираем решение под архитектуру и размер проёмов.',
    features: [
      'Большие и панорамные конструкции',
      'Ламинация в цвет по каталогу RAL',
      'Энергоэффективные стеклопакеты',
      'Расчёт теплопотерь и консультация',
    ],
  },
  {
    id: 'quiet',
    icon: 'quiet',
    title: 'Тихие (шумозащитные) окна',
    price: 'от 6 000 lei',
    text: 'Снижаем уличный шум вплоть до 40 дБ — подходит для домов рядом с дорогой, трассой или железной дорогой.',
    features: [
      'Асимметричные шумозащитные стеклопакеты',
      'Разная толщина стёкол для гашения частот',
      'Усиленная фурнитура и герметичный монтаж',
      'Замер уровня шума в квартире',
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Услуги DENDY IMPERIAL WIND HUB',
  url: canonicalUrl,
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.title,
      description: service.text,
      areaServed: 'RU',
      provider: {
        '@type': 'LocalBusiness',
        name: 'DENDY IMPERIAL WIND HUB',
        telephone: '+78001234567',
      },
    },
  })),
};
---

<Layout title={title} description={description} lang="ru" activePage="services">
	<main id="main-content">
		<section class="hero-block wrap">
			<h1>Услуги</h1>
			<p class="lead">
				Производим и устанавливаем пластиковые окна под ключ: от замера и изготовления до
				монтажа и сервисного обслуживания. Выберите подходящее направление или закажите
				бесплатную консультацию.
			</p>
		</section>

		<section class="section wrap" aria-labelledby="list-title">
			<h2 id="list-title" class="visually-hidden">Список услуг</h2>

			<div class="services">
				{
					services.map((service) => (
						<article class="service" id={service.id}>
							<div class="service__head">
								<span class="service__icon">
									<Icon name={service.icon} size={26} />
								</span>
								<div>
									<h3 class="service__title">{service.title}</h3>
									<p class="service__price">{service.price}</p>
								</div>
							</div>
							<p class="service__text">{service.text}</p>
							<ul class="service__features">
								{service.features.map((feature) => (
									<li>
										<Icon name="check" size={16} />
										{feature}
									</li>
								))}
							</ul>
							<a class="service__cta" href={`${base}contacts/#form`}>
								Заказать замер
								<Icon name="arrow-right" size={16} />
							</a>
						</article>
					))
				}
			</div>
		</section>

		<CtaSection base={base} />
	</main>

	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style>
	.wrap {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 var(--space-2);
	}

	.hero-block {
		max-width: var(--maxw-narrow);
		padding-top: var(--space-5);
	}

	h1 {
		margin: 0 0 var(--space-2);
		font-size: var(--font-size-h1);
		line-height: var(--line-height-heading);
		letter-spacing: var(--letter-spacing-tight);
	}

	.lead {
		margin: 0;
		font-size: var(--font-size-lead);
		color: var(--color-muted);
	}

	.section {
		margin-top: var(--space-5);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	.services {
		display: grid;
		gap: var(--space-3);
		grid-template-columns: 1fr;
	}

	.service {
		display: grid;
		gap: var(--space-2);
		align-content: start;
		padding: var(--space-3);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
	}

	.service__head {
		display: flex;
		gap: var(--space-2);
		align-items: center;
	}

	.service__icon {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: 3rem;
		height: 3rem;
		border-radius: var(--radius);
		background: color-mix(in srgb, var(--color-brand) 12%, transparent);
		color: var(--color-brand);
	}

	.service__title {
		margin: 0;
		font-size: var(--font-size-h3);
	}

	.service__price {
		margin: 0.25em 0 0;
		color: var(--color-accent);
		font-weight: var(--font-weight-bold);
	}

	.service__text {
		margin: 0;
		color: var(--color-muted);
	}

	.service__features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-1);
	}

	.service__features li {
		display: flex;
		gap: var(--space-1);
		align-items: flex-start;
		color: var(--color-muted);
	}

	.service__features li :global(svg) {
		flex: 0 0 auto;
		margin-top: 0.25em;
		color: var(--color-accent);
	}

	.service__cta {
		justify-self: start;
		margin-top: var(--space-1);
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius);
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-weight: var(--font-weight-medium);
		text-decoration: none;
	}

	.service__cta:hover {
		background: var(--color-brand-strong);
	}

	a:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	@media (prefers-reduced-motion: no-preference) {
		.service__cta {
			transition: background-color var(--transition-fast);
		}
	}

	@media (min-width: 48rem) {
		.services {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
