---
import Layout from '../layouts/Layout.astro';

// SEO: title 30-60 chars, description 120-160 chars
const title = 'Контакты — Окна-Сервис: телефон и адрес';
const description =
  'Телефон +7 (800) 123-45-67, email zakaz@okna-service.example. Оставьте заявку на бесплатный замер окон онлайн — свяжемся в ближайшее время.';

// Normalize BASE_URL so paths never collapse into /okna-sitecontacts/
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

// Canonical URL for structured data, computed here (not inside set:html)
const canonicalUrl =
  Astro.site != null
    ? new URL(Astro.url.pathname, Astro.site).href
    : Astro.url.pathname;

const phoneDisplay = '+7 (800) 123-45-67';
const phoneHref = 'tel:+78001234567';
const email = 'zakaz@okna-service.example';
const address = 'г. Ваш город, ул. Примерная, д. 1';
---

<Layout title={title} description={description} lang="ru">
	<a class="skip-link" href="#main-content">Перейти к основному содержанию</a>

	<header class="site-header">
		<div class="site-header__inner">
			<a class="brand" href={base}>Окна-Сервис</a>
			<nav aria-label="Основная навигация">
				<ul class="nav">
					<li><a href={base}>Главная</a></li>
					<li><a href={`${base}about/`}>О нас</a></li>
					<li><a href={`${base}contacts/`} aria-current="page">Контакты</a></li>
				</ul>
			</nav>
		</div>
	</header>

	<main id="main-content">
		<article class="contacts">
			<h1>Контакты</h1>
			<p>
				Свяжитесь с нами удобным способом или оставьте заявку — мы перезвоним и ответим на
				все вопросы по окнам.
			</p>

			<section class="section" aria-labelledby="details-title">
				<h2 id="details-title">Контактные данные</h2>
				<ul class="contact-list">
					<li>
						<strong>Телефон</strong>
						<a href={phoneHref}>{phoneDisplay}</a>
					</li>
					<li>
						<strong>Email</strong>
						<a href={`mailto:${email}`}>{email}</a>
					</li>
					<li>
						<strong>Адрес</strong>
						<span>{address}</span>
					</li>
					<li>
						<strong>Режим работы</strong>
						<span>Пн–Сб: 9:00–20:00, Вс: выходной</span>
					</li>
				</ul>
			</section>

			<section class="section" aria-labelledby="form-title">
				<h2 id="form-title">Оставить заявку</h2>
				<form class="form" method="post" action="#">
					<div class="field">
						<label for="name">Имя</label>
						<input
							type="text"
							id="name"
							name="name"
							autocomplete="name"
							required
						/>
					</div>

					<div class="field">
						<label for="phone">Телефон</label>
						<input
							type="tel"
							id="phone"
							name="phone"
							autocomplete="tel"
							required
						/>
					</div>

					<div class="field">
						<label for="comment">Комментарий</label>
						<textarea id="comment" name="comment" rows="4"></textarea>
					</div>

					<button class="button" type="submit">Отправить заявку</button>
				</form>
			</section>

			<p class="back">
				<a href={base}>Вернуться на главную</a>
			</p>
		</article>
	</main>

	<footer class="site-footer">
		<p>© 2024 Окна-Сервис. Все права защищены.</p>
	</footer>

	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'LocalBusiness',
			name: 'Окна-Сервис',
			description,
			url: canonicalUrl,
			telephone: '+78001234567',
			email: 'zakaz@okna-service.example',
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'ул. Примерная, д. 1',
				addressLocality: 'Ваш город',
				addressCountry: 'RU',
			},
			openingHours: 'Mo-Sa 09:00-20:00',
		})}
	/>
</Layout>

<style>
	/* All values come from design-system tokens (src/styles/theme.css).
	   @see AGENTS.md -> kronk-theme-guard */

	:global(body) {
		font-family: var(--font);
		color: var(--color-text);
		background: var(--color-bg);
	}

	a:focus-visible,
	button:focus-visible,
	input:focus-visible,
	textarea:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 2px;
		border-radius: var(--radius-sm);
	}

	.skip-link {
		position: absolute;
		left: var(--space-2);
		top: -3rem;
		z-index: 10;
		background: var(--color-brand);
		color: var(--color-on-brand);
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius);
		text-decoration: none;
	}

	.skip-link:focus {
		top: var(--space-2);
	}

	.site-header {
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__inner {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: var(--space-2);
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		align-items: center;
		justify-content: space-between;
	}

	.brand {
		font-size: var(--font-size-h3);
		font-weight: var(--font-weight-bold);
		color: var(--color-text);
		text-decoration: none;
	}

	.nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav a {
		color: var(--color-muted);
		text-decoration: none;
	}

	.nav a:hover {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.nav a[aria-current='page'] {
		color: var(--color-text);
		font-weight: var(--font-weight-medium);
	}

	main {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: var(--space-4) var(--space-2);
	}

	.contacts {
		max-width: 45rem;
	}

	h1 {
		font-size: var(--font-size-h1);
		line-height: var(--line-height-heading);
		margin: 0 0 0.5em;
	}

	h2 {
		font-size: var(--font-size-h2);
		line-height: var(--line-height-heading);
		margin: 0 0 var(--space-2);
	}

	.contacts > p {
		color: var(--color-muted);
		letter-spacing: var(--letter-spacing-tight);
	}

	.section {
		margin-top: var(--space-4);
	}

	.contact-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
	}

	.contact-list li {
		color: var(--color-muted);
	}

	.contact-list strong {
		display: block;
		color: var(--color-text);
		font-weight: var(--font-weight-medium);
	}

	.contact-list a {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.contact-list a:hover {
		color: var(--color-brand-strong);
	}

	.form {
		display: grid;
		gap: var(--space-3);
		margin: 0;
		padding: var(--space-3);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.field {
		display: grid;
		gap: var(--space-1);
	}

	.field label {
		color: var(--color-text);
		font-weight: var(--font-weight-medium);
	}

	.field input,
	.field textarea {
		box-sizing: border-box;
		width: 100%;
		font-family: var(--font);
		font-size: var(--font-size-base);
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: var(--space-2);
	}

	.field textarea {
		min-height: 8rem;
		resize: vertical;
	}

	.field input:focus-visible,
	.field textarea:focus-visible {
		border-color: var(--color-brand);
	}

	.button {
		justify-self: start;
		display: inline-block;
		font-family: var(--font);
		font-size: var(--font-size-base);
		font-weight: var(--font-weight-medium);
		color: var(--color-on-brand);
		background: var(--color-brand);
		border: 1px solid transparent;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius);
		cursor: pointer;
	}

	.button:hover {
		background: var(--color-brand-strong);
	}

	.back {
		margin-top: var(--space-4);
	}

	.back a {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.back a:hover {
		color: var(--color-brand-strong);
	}

	.site-footer {
		border-top: 1px solid var(--color-border);
	}

	.site-footer p {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: var(--space-3) var(--space-2);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	@media (prefers-reduced-motion: no-preference) {
		.skip-link,
		.button {
			transition: top 0.2s ease, background-color 0.2s ease;
		}
	}
</style>