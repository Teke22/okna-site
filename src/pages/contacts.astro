---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

// SEO: title 30–60 символов, description 120–160 символов
const title = 'Контакты DENDY IMPERIAL WIN HUB — телефон и адрес';
const description =
  'Позвоните по телефону +7 (800) 123-45-67 или оставьте заявку на бесплатный замер окон онлайн. Работаем Пн–Сб с 9:00 до 20:00.';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const canonicalUrl =
  Astro.site != null ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const phoneDisplay = '+7 (800) 123-45-67';
const phoneHref = 'tel:+78001234567';
const email = 'zakaz@okna-service.example';
const address = 'г. Кишинёв, ул. Примерная, д. 1';
const hours = 'Пн–Сб: 9:00–20:00, Вс: выходной';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  description,
  url: canonicalUrl,
  mainEntity: {
    '@type': 'LocalBusiness',
    name: 'DENDY IMPERIAL WIN HUB',
    telephone: '+78001234567',
    email,
    priceRange: '$$',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'ул. Примерная, д. 1',
      addressLocality: 'Кишинёв',
      addressCountry: 'MD',
    },
    openingHours: 'Mo-Sa 09:00-20:00',
  },
};
---

<Layout title={title} description={description} lang="ru" activePage="contacts">
	<main id="main-content">
		<section class="hero-block wrap">
			<h1>Контакты</h1>
			<p class="lead">
				Свяжитесь с нами удобным способом или оставьте заявку — перезвоним, ответим на вопросы
				и запишем на бесплатный замер в удобное время.
			</p>
		</section>

		<div class="contacts-grid wrap">
			<section class="card" aria-labelledby="details-title">
				<h2 id="details-title">Контактные данные</h2>
				<ul class="contact-list">
					<li>
						<span class="contact-list__icon"><Icon name="phone" size={18} /></span>
						<span class="contact-list__body">
							<strong>Телефон</strong>
							<a href={phoneHref}>{phoneDisplay}</a>
						</span>
					</li>
					<li>
						<span class="contact-list__icon"><Icon name="mail" size={18} /></span>
						<span class="contact-list__body">
							<strong>Email</strong>
							<a href={`mailto:${email}`}>{email}</a>
						</span>
					</li>
					<li>
						<span class="contact-list__icon"><Icon name="map-pin" size={18} /></span>
						<span class="contact-list__body">
							<strong>Адрес</strong>
							<span>{address}</span>
						</span>
					</li>
					<li>
						<span class="contact-list__icon"><Icon name="clock" size={18} /></span>
						<span class="contact-list__body">
							<strong>Режим работы</strong>
							<span>{hours}</span>
						</span>
					</li>
				</ul>
			</section>

			<section class="card" id="form" aria-labelledby="form-title">
				<h2 id="form-title">Оставить заявку</h2>
				<p class="form-hint">Заполните форму — мы свяжемся с вами в течение рабочего дня.</p>
				<form class="form" method="post" action="#">
					<div class="field">
						<label for="name">Имя</label>
						<input type="text" id="name" name="name" autocomplete="name" required />
					</div>

					<div class="field">
						<label for="phone">Телефон</label>
						<input type="tel" id="phone" name="phone" autocomplete="tel" required />
					</div>

					<div class="field">
						<label for="comment">Комментарий</label>
						<textarea id="comment" name="comment" rows="4"></textarea>
					</div>

					<button class="button" type="submit">Отправить заявку</button>
				</form>
			</section>
		</div>

		<p class="back wrap">
			<a href={base}>Вернуться на главную</a>
		</p>
	</main>

	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style>
	.wrap {
		max-width: var(--maxw-narrow);
		margin: 0 auto;
		padding: 0 var(--space-2);
	}

	.hero-block {
		padding-top: var(--space-5);
	}

	h1 {
		margin: 0 0 var(--space-2);
		font-size: var(--font-size-h1);
		line-height: var(--line-height-heading);
		letter-spacing: var(--letter-spacing-tight);
	}

	.lead {
		margin: 0;
		font-size: var(--font-size-lead);
		color: var(--color-muted);
	}

	.contacts-grid {
		margin-top: var(--space-4);
		display: grid;
		gap: var(--space-3);
		grid-template-columns: 1fr;
	}

	h2 {
		margin: 0 0 var(--space-2);
		font-size: var(--font-size-h2);
		line-height: var(--line-height-heading);
	}

	.card {
		padding: var(--space-3);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.contact-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
	}

	.contact-list li {
		display: flex;
		gap: var(--space-2);
		align-items: flex-start;
	}

	.contact-list__icon {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: var(--radius);
		background: color-mix(in srgb, var(--color-brand) 12%, transparent);
		color: var(--color-brand);
	}

	.contact-list__body {
		display: grid;
		gap: 0.125rem;
	}

	.contact-list__body strong {
		color: var(--color-text);
		font-weight: var(--font-weight-medium);
	}

	.contact-list__body span {
		color: var(--color-muted);
	}

	.contact-list__body a {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.contact-list__body a:hover {
		color: var(--color-brand-strong);
	}

	.form-hint {
		margin: 0 0 var(--space-2);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.form {
		display: grid;
		gap: var(--space-3);
	}

	.field {
		display: grid;
		gap: var(--space-1);
	}

	.field label {
		color: var(--color-text);
		font-weight: var(--font-weight-medium);
	}

	.field input,
	.field textarea {
		box-sizing: border-box;
		width: 100%;
		font-family: var(--font);
		font-size: var(--font-size-base);
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: var(--space-2);
	}

	.field textarea {
		min-height: 8rem;
		resize: vertical;
	}

	.field input:focus-visible,
	.field textarea:focus-visible {
		border-color: var(--color-brand);
	}

	.button {
		justify-self: start;
		display: inline-block;
		font-family: var(--font);
		font-size: var(--font-size-base);
		font-weight: var(--font-weight-medium);
		color: var(--color-on-brand);
		background: var(--color-brand);
		border: 1px solid transparent;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius);
		cursor: pointer;
	}

	.button:hover {
		background: var(--color-brand-strong);
	}

	.back {
		margin: var(--space-4) auto 0;
	}

	.back a {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.back a:hover {
		color: var(--color-brand-strong);
	}

	@media (prefers-reduced-motion: no-preference) {
		.button {
			transition: background-color var(--transition-fast);
		}
	}

	@media (min-width: 48rem) {
		.contacts-grid {
			grid-template-columns: 1fr 1.2fr;
			align-items: start;
		}
	}
</style>
