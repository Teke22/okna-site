---
import Layout from '../layouts/Layout.astro';
import WindowCalculator from '../components/WindowCalculator.astro';
import CtaSection from '../components/CtaSection.astro';

// SEO: title 30–60 символов, description 120–160 символов
const title = 'Калькулятор стоимости пластиковых окон | Окна-Сервис';
const description =
  'Рассчитайте предварительную стоимость пластикового окна онлайн: тип конструкции, размеры, профиль, стеклопакет и опции. Быстрый расчёт цены.';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const canonicalUrl =
  Astro.site != null ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Калькулятор стоимости пластиковых окон',
  description,
  url: canonicalUrl,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  inLanguage: 'ru-RU',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'RUB',
  },
  provider: {
    '@type': 'LocalBusiness',
    name: 'Окна-Сервис',
    telephone: '+78001234567',
  },
};
---

<Layout title={title} description={description} lang="ru" activePage="calculator">
	<main id="main-content">
		<section class="hero-block wrap">
			<h1>Калькулятор стоимости окон</h1>
			<p class="lead">
				Укажите размеры и параметры окна — калькулятор мгновенно покажет предварительную
				стоимость и разбивку по позициям. Итоговая цена уточняется после бесплатного замера.
			</p>
		</section>

		<section class="section wrap" aria-labelledby="calc-title">
			<h2 id="calc-title" class="visually-hidden">Параметры расчёта стоимости</h2>
			<WindowCalculator />
		</section>

		<section class="section wrap" aria-labelledby="how-title">
			<h2 id="how-title">Что входит в расчёт</h2>
			<ul class="notes">
				<li><strong>Профильная система</strong> — стоимость зависит от класса профиля и площади окна.</li>
				<li><strong>Стеклопакет</strong> — однокамерный, двухкамерный или энергосберегающий.</li>
				<li><strong>Фурнитура и комплектующие</strong> — с учётом числа створок и типа конструкции.</li>
				<li><strong>Дополнительные опции</strong> — москитная сетка, подоконник, отлив, демонтаж.</li>
				<li><strong>Монтаж</strong> — установка по ГОСТ с пароизоляцией шва.</li>
			</ul>
		</section>

		<CtaSection base={base} />
	</main>

	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style>
	.wrap {
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 var(--space-2);
	}

	.hero-block {
		max-width: var(--maxw-narrow);
		padding-top: var(--space-5);
	}

	h1 {
		margin: 0 0 var(--space-2);
		font-size: var(--font-size-h1);
		line-height: var(--line-height-heading);
		letter-spacing: var(--letter-spacing-tight);
	}

	.lead {
		margin: 0;
		font-size: var(--font-size-lead);
		color: var(--color-muted);
	}

	.section {
		margin-top: var(--space-5);
	}

	.section h2 {
		margin: 0 0 var(--space-2);
		font-size: var(--font-size-h2);
		line-height: var(--line-height-heading);
	}

	.notes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
		grid-template-columns: 1fr;
	}

	.notes li {
		padding: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
		color: var(--color-muted);
	}

	.notes strong {
		color: var(--color-text);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	@media (min-width: 48rem) {
		.notes {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
